rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      
      // Daily records: /users/{userId}/records/{docId}
      match /records/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Monthly notes: /users/{userId}/notes/{monthYear}
      match /notes/{monthYear} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
